{
  "name": "buildguard-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postbuild": "node scripts/postbuild.mjs",
    "test:browser": "node tests-browser/sweep.e2e.mjs && node tests-browser/behaviour.e2e.mjs && node tests-browser/golden-path.e2e.mjs",
    "test:integration": "node tests-integration/contract.e2e.mjs && node tests-integration/bff.e2e.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.48.0",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
